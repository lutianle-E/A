<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EYE.CON Studio — Eyewear Design Portfolio</title>

    <!-- ===== Security Meta Tags ===== -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
    <meta http-equiv="X-XSS-Protection" content="1; mode=block" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- SEO / Crawler -->
    <meta name="description" content="EYE.CON Studio — 眼镜设计师品牌，专注于前卫光学设计与视觉叙事。" />
    <meta name="robots" content="index, follow" />

    <!-- ===== 性能优化：DNS预解析 & 预连接 ===== -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- ===== 性能优化：首屏关键图片预加载 ===== -->
    <link rel="preload" as="image" href="./images/07-anime-pink-glasses.webp" fetchpriority="high" />
    <link rel="preload" as="image" href="./images/07-anime-pink-glasses-blur.webp" />

    <!-- 字体异步加载，避免阻塞渲染 -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" /></noscript>
    <script type="module" crossorigin src="./assets/index-BBaXb4Au.js"></script>
    <link rel="modulepreload" crossorigin href="./assets/react-Dh3zDKDA.js">
    <link rel="stylesheet" crossorigin href="./assets/index-BA73Q5pi.css">
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
